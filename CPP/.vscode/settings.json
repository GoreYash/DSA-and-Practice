{
    "files.associations": {
        "sstream": "cpp",
        "regex": "cpp",
        "iostream": "cpp",
        "ostream": "cpp"
    },

    "code-runner.executorMap": {
        "cpp": "g++ \"$fileName\" -o \"$workspaceRoot/bin/$fileNameWithoutExt.exe\" ; if ($?) { & \"$workspaceRoot/bin/$fileNameWithoutExt.exe\" }"
    }    
}    
